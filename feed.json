sts/10/gallery/0-Phileas_Dazeley_Gaist-6.png\" data-size=\"512x384\"><img loading=\"lazy\" src=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-6-thumbnail.png\" alt=\"\" width=\"512\" height=\"384\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-7.png\" data-size=\"512x682\"><img loading=\"lazy\" src=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-7-thumbnail.png\" alt=\"\" width=\"512\" height=\"682\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-8.png\" data-size=\"512x422\"><img loading=\"lazy\" src=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-8-thumbnail.png\" alt=\"\" width=\"512\" height=\"422\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-9.png\" data-size=\"512x744\"><img loading=\"lazy\" src=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-9-thumbnail.png\" alt=\"\" width=\"512\" height=\"744\"></a></figure>\n<figure class=\"gallery__item\"><a href=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-10.png\" data-size=\"512x413\"><img loading=\"lazy\" src=\"https://phileasdg.github.io/sympoietic/media/posts/10/gallery/0-Phileas_Dazeley_Gaist-10-thumbnail.png\" alt=\"\" width=\"512\" height=\"413\"></a></figure>\n</div></div>",
